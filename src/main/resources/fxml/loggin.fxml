<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.stockcontroller.controller.view.LoginViewController"
            prefHeight="400.0" prefWidth="400.0">
    <children>
        <VBox alignment="CENTER" spacing="18" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="60.0">
            <Label text="Iniciar Sesión" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TextField fx:id="txtEmail" promptText="Correo electrónico" maxWidth="220"/>
            <PasswordField fx:id="txtPassword" promptText="Contraseña" maxWidth="220"/>
            <Button fx:id="btnLogin" text="Entrar" maxWidth="140"/>
        </VBox>
    </children>
</AnchorPane>
