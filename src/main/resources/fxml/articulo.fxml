<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="560.0" prefWidth="800.0" styleClass="form-card" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.stockcontroller.controller.view.ArticuloViewController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="8" left="24" right="24" top="18" />
            </padding>
            <HBox alignment="CENTER" spacing="12">
                <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="GESTIÓN DE ARTÍCULOS">
               <font>
                  <Font name="Constantia" size="12.0" />
               </font></Label>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="16">
            <padding>
                <Insets bottom="14" left="32" right="32" top="12" />
            </padding>

            <TableView fx:id="tablaArticulos" minWidth="720" prefHeight="240">
                <columns>
                    <TableColumn fx:id="columnaNombre" prefWidth="160" text="Nombre" />
                    <TableColumn fx:id="columnaDescripcion" prefWidth="220" text="Descripción" />
                    <TableColumn fx:id="columnaPrecio" prefWidth="110" text="Precio (€)" />
                    <TableColumn fx:id="columnaStock" prefWidth="80" text="Stock" />
                    <TableColumn fx:id="columnaStockMinimo" prefWidth="110" text="Stock Mínimo" />
                </columns>
            </TableView>

            <GridPane hgap="14" vgap="11">
                <padding>
                    <Insets bottom="8" left="10" right="10" top="15" />
                </padding>

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0">
               <font>
                  <Font name="Marlett" size="12.0" />
               </font></Label>
                <TextField fx:id="campoNombre" maxWidth="215" styleClass="input-login" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1">
               <font>
                  <Font name="Myanmar Text" size="12.0" />
               </font></Label>
                <TextField fx:id="campoDescripcion" maxWidth="215" styleClass="input-login" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Precio (€):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="campoPrecio" maxWidth="215" styleClass="input-login" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="campoStock" maxWidth="215" styleClass="input-login" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Stock Mínimo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="campoStockMinimo" maxWidth="215" styleClass="input-login" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <columnConstraints>
               <ColumnConstraints maxWidth="98.0" minWidth="79.4" prefWidth="79.4" />
               <ColumnConstraints maxWidth="147.0" minWidth="127.6" prefWidth="147.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="13">
                <Button fx:id="btnCrear" onAction="#crearArticulo" prefWidth="110" styleClass="btn-crear" text="Crear" />
                <Button fx:id="btnActualizar" onAction="#actualizarArticulo" prefWidth="110" styleClass="btn-actualizar" text="Actualizar" />
                <Button fx:id="btnEliminar" onAction="#eliminarArticulo" prefWidth="110" styleClass="btn-eliminar" text="Eliminar" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="18" left="10" right="24" top="10" />
            </padding>
         <children>
               <Button fx:id="btnVolver" onAction="#volverAlDashboard" prefHeight="26.0" prefWidth="116.0" styleClass="btn-secundario" text="◀ Volver al Inicio" />
         </children>
        </HBox>
    </bottom>
</BorderPane>
