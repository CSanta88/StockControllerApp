<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.stockcontroller.controller.view.ProveedorViewController"
            prefWidth="800.0" prefHeight="600.0">

    <stylesheets>
        <URL value="@../css/estilos.css" />
    </stylesheets>

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="10" alignment="CENTER">
                <Label text="GESTIÓN DE PROVEEDORES" style="-fx-font-size: 30px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="campoBusqueda" promptText="Buscar por nombre..." />
                <Button onAction="#buscarPorNombre" prefWidth="45" styleClass="btn-lupa" text="🔍" />
                <Button onAction="#cargarProveedores" prefHeight="42.0" prefWidth="78.0" styleClass="btn-secundario" text="Ver Todos" wrapText="true" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="tablaProveedores" prefHeight="180">
                <columns>
                    <TableColumn fx:id="columnaNombre" prefWidth="180" text="Nombre" />
                    <TableColumn fx:id="columnaDireccion" prefWidth="230" text="Dirección" />
                    <TableColumn fx:id="columnaEmail" prefWidth="200" text="Email" />
                    <TableColumn fx:id="columnaTelefono" prefWidth="120" text="Teléfono" />
                </columns>
            </TableView>

            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="campoNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="campoDireccion" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="campoEmail" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="campoTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <!-- Tabla de artículos más grande -->
                <Label text="Artículos que ofrece:" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.valignment="TOP"/>
                <TableView fx:id="tablaArticulosProveedor"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"
                           prefHeight="300" editable="true">
                    <columns>
                        <TableColumn fx:id="colSeleccion" text="Asignado" prefWidth="80"/>
                        <TableColumn fx:id="colArticulo" text="Artículo" prefWidth="280"/>
                        <TableColumn fx:id="colPrecio" text="Precio Compra (€)" prefWidth="130"/>
                    </columns>
                </TableView>
            </GridPane>

            <HBox spacing="15" alignment="CENTER">
                <Button onAction="#crearProveedor" prefWidth="120" styleClass="btn-crear" text="Crear" />
                <Button onAction="#actualizarProveedor" prefWidth="120" styleClass="btn-actualizar" text="Actualizar" />
                <Button onAction="#eliminarProveedor" prefWidth="120" styleClass="btn-eliminar" text="Eliminar" />
                <Button onAction="#limpiarCampos" prefWidth="120" styleClass="btn-secundario" text="Limpiar" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="20" bottom="20" left="10"/>
            </padding>
            <Button onAction="#volverAlDashboard" prefWidth="160" styleClass="btn-secundario" text="◀ Volver al Inicio" />
        </HBox>
    </bottom>
</BorderPane>
