<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.stockcontroller.controller.view.ProveedorViewController"
            prefWidth="800.0" prefHeight="600.0">

    <stylesheets>
        <URL value="@../css/estilos.css"/>
    </stylesheets>

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="10">
                <Button fx:id="btnVolver" text="Volver al Dashboard" styleClass="btn-secundario"/>
                <Label text="Gestión de Proveedores" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="campoBusqueda" promptText="Buscar por nombre..." />
                <Button text="Buscar" onAction="#buscarPorNombre" styleClass="btn-primario"/>
                <Button text="Mostrar Todos" onAction="#cargarProveedores" styleClass="btn-secundario"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="tablaProveedores">
                <columns>
                    <TableColumn fx:id="columnaNombre" text="Nombre"/>
                    <TableColumn fx:id="columnaEmail" text="Email"/>
                    <TableColumn fx:id="columnaTelefono" text="Teléfono"/>
                </columns>
            </TableView>

            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="campoEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="campoTelefono" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Crear" onAction="#crearProveedor" styleClass="btn-crear"/>
                <Button text="Actualizar" onAction="#actualizarProveedor" styleClass="btn-actualizar"/>
                <Button text="Eliminar" onAction="#eliminarProveedor" styleClass="btn-eliminar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
